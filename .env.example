# Application environment
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=investment-research

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/investment_research
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally)
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=research
OBJECT_STORAGE_SECURE=false

# LLM (optional for foundation phase)
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Crawler
CRAWLER_USER_AGENT=InvestmentResearchBot/0.1
CRAWLER_RATE_LIMIT_SECONDS=1.0
